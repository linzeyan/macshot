<?xml version="1.0" encoding="utf-8"?>
<!--
  The template windows/tools/pack-msix.ps1 fills in. Every value below that differs
  between the four builds - identity name, publisher, version, architecture, display name
  and the executable's file name - is a placeholder the script overwrites; the rest is the
  package as it ships. One template rather than four, because the parts that vary are
  mechanical and a second copy would drift in the parts that do not.

  Publisher in particular cannot be committed: an MSIX only installs when its Publisher
  string is character-for-character the signing certificate's subject, and there is no
  certificate yet. The script reads the subject out of the .pfx it is given.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="Macshot.Windows"
      Publisher="CN=macshot"
      Version="0.0.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>macshot</DisplayName>
    <PublisherDisplayName>macshot</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- The same floor the app itself declares in SupportedOSPlatformVersion. A package
       that claimed less would install on a machine the Windows App SDK will not start
       on, which is a failure at launch instead of at install. -->
  <Dependencies>
    <TargetDeviceFamily
        Name="Windows.Desktop"
        MinVersion="10.0.19041.0"
        MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <!-- Declared here rather than in a resources.pri. The package carries none: every
       string in this manifest is a literal and every logo is a literal path, so there is
       nothing for the resource indexer to resolve. The app's own Macshot.Windows.pri,
       which the XAML compiler produces, travels in the payload and is unaffected. -->
  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
        Id="App"
        Executable="Macshot.Windows.exe"
        EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="macshot"
          Description="Screenshot and annotation for Windows."
          BackgroundColor="transparent"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <!-- macshot reads every pixel on every display, writes files the user chooses, and
       talks to the shell's notification area. That is a full-trust desktop program, not
       a sandboxed one, and runFullTrust is what says so. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
