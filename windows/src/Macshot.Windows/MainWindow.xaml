<Window
    x:Class="Macshot.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Macshot.Windows"
    Title="Macshot">
    <Grid RowDefinitions="Auto,*" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <CommandBar DefaultLabelPosition="Right">
            <AppBarButton Icon="Camera" Label="Capture area" Click="CaptureArea_Click" />
            <AppBarButton Icon="FullScreen" Label="Capture all screens" Click="CaptureAllScreens_Click" />
            <AppBarSeparator />
            <!-- OneTime, not OneWay: HasCapture raises no change notification, and the
                 code-behind already calls Bindings.Update() at every point that changes
                 it, which re-evaluates these. -->
            <AppBarButton Icon="Save" Label="Save PNG" IsEnabled="{x:Bind HasCapture, Mode=OneTime}" Click="SavePng_Click" />
            <AppBarButton Icon="Clear" Label="Clear" IsEnabled="{x:Bind HasCapture, Mode=OneTime}" Click="Clear_Click" />
        </CommandBar>

        <Grid Grid.Row="1" Padding="16" RowDefinitions="*,Auto" RowSpacing="12">
            <Border Background="#171717" CornerRadius="8">
                <Canvas
                    x:Name="PreviewCanvas"
                    Background="#171717"
                    PointerPressed="PreviewCanvas_PointerPressed"
                    PointerMoved="PreviewCanvas_PointerMoved"
                    PointerReleased="PreviewCanvas_PointerReleased">
                    <Image x:Name="PreviewImage" Stretch="None" />
                    <Rectangle
                        x:Name="SelectionRectangle"
                        Visibility="Collapsed"
                        Stroke="#4CC2FF"
                        StrokeThickness="2"
                        Fill="#334CC2FF" />
                </Canvas>
            </Border>

            <TextBlock
                Grid.Row="1"
                Text="Capture your virtual desktop, then drag to select an editing region."
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </Grid>
    </Grid>
</Window>
