<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged unless the command line asks otherwise, which is the only thing that
         is the same in both, because there is only one publish. Setting it to MSIX was
         tried and does not build at all — a single-project MSIX wants the manifest as a
         project item, and this one keeps its manifest out in windows/packaging/msix so
         that one template serves all four legs. The package is made from this publish,
         and it installs and launches. See windows/tools/pack-msix.ps1. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Not about MSIX, despite the name, and not optional. It is what brings in the
         packaging targets that hand the XAML compiler's output — every .xbf and the app's
         own .pri — to publish. Without it `dotnet build` produces them and `dotnet publish`
         silently leaves all nineteen behind, so the published app starts, shows its tray
         icon, and throws XamlParseException out of the first window it is asked to open.
         The build output ran; only what shipped was broken. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <!-- A self-contained Windows App SDK app must resolve a concrete architecture. A
         solution build comes through as AnyCPU, which the SDK rejects, so there is a
         default here; the release workflow overrides it to publish win-arm64 as well.
         Conditional rather than fixed, because -r on the command line sets this property
         and a fixed value would silently win over it. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>

    <!-- What the About page shows and what the update check compares against a release
         tag. The release workflow passes the tag's version; this is what a build off a
         working tree calls itself, and it is deliberately below any published version so
         a development build is never offered to itself as an update. -->
    <Version Condition="'$(Version)' == ''">0.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- The same artwork the Mac app uses, converted to a multi-resolution .ico. This
         gives the executable its own icon in Explorer and Alt+Tab; the notification-area
         icon loads the same file at run time, because the shell wants a specific pixel
         size for the current DPI and only the file has every size in it. -->
    <ApplicationIcon>Assets\macshot.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Update rather than Include: the SDK already globs this file as None, and adding
       it a second time as Content is a duplicate-item build failure. Copying it is only
       an optimization anyway — the icon is embedded in the executable by
       ApplicationIcon above, and TrayIconService falls back to reading it from there. -->
  <ItemGroup>
    <None Update="Assets\macshot.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The offline variant, selected with -p:Variant=Offline. The same tree with every
       network feature compiled out rather than a second project, because a fork would
       drift: the point of the variant is that it is provably the same app minus the
       uploads, and a compiler that fails on a stray reference is the only thing that
       can prove it. This mirrors the macOS OFFLINE condition. -->
  <PropertyGroup Condition="'$(Variant)' == 'Offline'">
    <DefineConstants>$(DefineConstants);OFFLINE</DefineConstants>
    <AssemblyName>Macshot.Windows.Offline</AssemblyName>
  </PropertyGroup>

  <!-- The upload toast's markup, not just its code. A #if around the code-behind is not
       enough for a XAML window: the generated half is still compiled, and it wires up
       event handlers that the removed half was supposed to declare. Removing the Page
       stops the generation, which is what actually takes the window out of the build. -->
  <ItemGroup Condition="'$(Variant)' == 'Offline'">
    <Page Remove="UploadToastWindow.xaml" />
  </ItemGroup>

  <!-- macshot has no window, so a copy of it left running from the last test is
       invisible: the only sign is the notification-area icon, and the only way out
       is its Quit entry. That copy holds the output assemblies, which turns the next
       build into MSB3027 about a file copy after forty seconds of retries — an error
       that says nothing about the app still running. Ending it first is what makes
       build, run, build work at all. Harmless where there is nothing to end, which
       is every CI run. -->
  <Target Name="StopRunningInstance" BeforeTargets="PrepareForBuild" Condition="'$(OS)' == 'Windows_NT'">
    <Exec
      Command="taskkill /IM $(AssemblyName).exe /F 2&gt;nul"
      IgnoreExitCode="true"
      StandardOutputImportance="low" />
  </Target>

  <!--
    The Windows App SDK by its parts rather than by its aggregate package, for one reason:
    the aggregate pulls Microsoft.WindowsAppSDK.ML, which pulls
    Microsoft.Windows.AI.MachineLearning — onnxruntime.dll and DirectML.dll, 42 MB of the
    publish and 17.8 of the 88 MB zip, for an inference runtime nothing here calls.

    Removing it does not remove background removal. That comes from .AI's
    Microsoft.Graphics.Imaging, and .AI depends only on .Base and .Foundation.

    .DWrite and .Widgets went the same way, and the check is the same one: no component
    package depends on either — only the aggregate does — and nothing here names
    DWriteCore or a widget. Each contributes exactly one native DLL, 3.10 MB and 2.36 MB.
    WinUI draws its text through the system DirectWrite; DWriteCore is a redistributable
    copy for apps that need a newer one than the machine has, which this is not.

    These are the versions Microsoft.WindowsAppSDK 2.2.0 pins, which is what makes this a
    subset of that package rather than a different set of components. They move together:
    to take a new SDK, read the aggregate's dependency list and copy it, minus .ML,
    .DWrite and .Widgets — then confirm against the component nuspecs that nothing kept
    has started depending on one of the three.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK.AI" Version="2.2.3" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.1.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.0.15" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.2.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.2.1" />
  </ItemGroup>

  <!--
    Do not drop WinUI's 172 .mui files. They look like 3.37 MB of pure overhead — 86
    locales of WinUI's own error text, for an app that carries its own translations — and
    removing them was tried here and reverted, because they are not only strings: the MRM
    resource loader wants them present. Without them the app still builds with no warning,
    still starts, still takes a screenshot, and then PreferencesWindow opens blank over

      COMException: The resource loader cache didn't load a MUI item.

    which is a failure no compiler, no test and no offline reasoning reaches. If this is
    ever retried, the check is opening preferences on the VM, not the file count.

    Two mechanical traps, recorded so the next attempt does not rediscover them: the SDK's
    own MicrosoftWindowsAppSDKFilesExcluded hook cannot match these files at all — its
    Remove is an exact string comparison against identities that keep an un-normalized
    "buildTransitive\..\" in them — and a target that removes them from None must use
    AfterTargets alone, since adding BeforeTargets="AssignTargetPaths" schedules it ahead
    of the payload target, where None holds no .mui yet and the removal silently does
    nothing.
  -->

  <!--
    Background removal's own runtime, and only where it can be reached. The offline variant
    fetches no model, so it has no use for a 15 MB native library - and shipping one for a
    code path that is compiled out is exactly what taking .ML out of the SDK above was for.

    CPU only. A GPU execution provider is another hundred megabytes of native code to make a
    tenth of a second faster, for a button pressed by hand.
  -->
  <ItemGroup Condition="'$(Variant)' != 'Offline'">
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.28.0" />
  </ItemGroup>

  <!--
    libwebp, which is the whole of WebP support: Windows enumerates no WebP encoder, so
    the format exists here only because this library is carried beside the app. About
    300 KB per architecture, BSD-licensed, and only the native binaries - the managed
    wrapper in the same family is not referenced, because Services/WebpEncoder.cs is four
    DllImports against the simple API.

    Both architectures, unconditionally. NuGet copies only runtimes/<the RID being built>,
    so an arm64 publish carries no x64 DLL and the other way round; a Condition on
    RuntimeIdentifier would say the same thing and be one more property to be wrong about
    during restore.
  -->
  <ItemGroup>
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-x64" Version="1.6.1" />
    <PackageReference Include="Imazen.WebP.NativeRuntime.win-arm64" Version="1.6.1" />
  </ItemGroup>

  <!--
    AVIF, the same story as libwebp one level further out: nothing on Windows writes it,
    and there is no NuGet package carrying an AV1 encoder the way Imazen carries libwebp.
    So it is built from source here - windows/native/macshot-avif, a Rust cdylib over the
    ravif crate - and Services/AvifEncoder.cs calls it through three DllImports.

    This makes a Rust toolchain a build dependency of the Windows half. That is a real
    cost and it is paid deliberately: the alternative is checking a pair of built DLLs
    into the repository, which nobody could reproduce or audit, for a binary that decodes
    every screenshot the app saves.

    One architecture per build, unlike libwebp above, because there is nothing to restore
    - the crate is compiled for whichever RID is being built, and cargo needs the exact
    triple rather than the RID.
  -->
  <PropertyGroup>
    <AvifCrateDirectory>$(MSBuildProjectDirectory)\..\..\native\macshot-avif</AvifCrateDirectory>
    <AvifRustTarget Condition="'$(RuntimeIdentifier)' == 'win-x64'">x86_64-pc-windows-msvc</AvifRustTarget>
    <AvifRustTarget Condition="'$(RuntimeIdentifier)' == 'win-arm64'">aarch64-pc-windows-msvc</AvifRustTarget>
    <AvifLibrary>$(AvifCrateDirectory)\target\$(AvifRustTarget)\release\macshot_avif.dll</AvifLibrary>
  </PropertyGroup>

  <!--
    Split in two so that the compile can be skipped while the copy still happens: a target
    with Inputs and Outputs that MSBuild finds up to date does not run its ItemGroup
    either, and the DLL would stop being copied on every build after the first.
  -->
  <Target Name="BuildNativeAvif"
          Inputs="$(AvifCrateDirectory)\Cargo.toml;$(AvifCrateDirectory)\Cargo.lock;$(AvifCrateDirectory)\src\lib.rs"
          Outputs="$(AvifLibrary)">
    <Error Condition="'$(AvifRustTarget)' == ''"
           Text="No Rust target is known for RuntimeIdentifier '$(RuntimeIdentifier)'. Add one beside the two in AvifRustTarget." />
    <!--
      A no-op cargo build is a fraction of a second, which is what keeps this off the
      15-second edit-compile loop the Windows VM exists to provide.
    -->
    <Exec Command="cargo build --release --target $(AvifRustTarget)"
          WorkingDirectory="$(AvifCrateDirectory)" />
  </Target>

  <Target Name="IncludeNativeAvif"
          BeforeTargets="AssignTargetPaths"
          DependsOnTargets="BuildNativeAvif">
    <ItemGroup>
      <Content Include="$(AvifLibrary)">
        <Link>macshot_avif.dll</Link>
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </Content>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Macshot.Windows.Core\Macshot.Windows.Core.csproj" />
  </ItemGroup>

  <!--
    The strings this port owns: what Windows names its own parts, and the handful of
    things the Windows build says that the Mac app has no words for. Kept apart from the
    upstream files below rather than added to them, because those are the Mac app's and
    are edited by its contributors — an entry about Copilot+ PCs in the Mac app's de.lproj
    would be a Windows string in a file no Windows build reads, and the sync script would
    overwrite it on the next refresh.

    Merged under macshot's at load time, so a key that exists in both resolves to the
    Mac app's wording. See Localization.Load.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\*.strings" LogicalName="Macshot.Windows.PortStrings.%(Filename).strings" />
  </ItemGroup>

  <!--
    macshot's own translations, vendored under Strings/upstream/. They are the Mac app's
    files, copied in rather than linked, because this branch does not carry the Mac tree:
    a relative path out to macshot/*.lproj/ is a build that only works in a working copy
    that has both, which this is not.

    Refresh them from the branch that owns them rather than editing them here:

      windows/tools/sync-upstream-strings.sh

    LogicalName is what Localization asks the assembly for. A key present in both these
    and Strings/*.strings resolves to the Mac app's wording — see Localization.Load.
  -->
  <ItemGroup>
    <EmbeddedResource Include="Strings\upstream\*.strings" LogicalName="Macshot.Windows.Strings.%(Filename).strings" />
  </ItemGroup>
</Project>
