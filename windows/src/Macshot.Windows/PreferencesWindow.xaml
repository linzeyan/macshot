<Window
    x:Class="Macshot.Windows.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Macshot.Windows"
    Title="Macshot Settings">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,*,Auto">
        <Grid.Resources>
            <!-- The three shapes every settings page here is built out of, which are the
                 three the macOS window is built out of: a small capitalised heading above
                 each group, a fixed-width right-aligned label beside each control, and a
                 dimmer caption under the ones that need explaining. macshot on Windows is
                 that product written in another language, and someone who knows the shape
                 of one window must recognise the other. -->

            <!-- Written as macshot writes it and put into capitals at runtime, not in the
                 markup: the capitals were what broke the translation, since "OUTPUT" is
                 not a key macshot ships and "Output" is. See ShoutTheSectionHeadings. -->
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- 4 here plus the section's own 6 is the 10 macOS puts after a heading. -->
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- 180 wide and right-aligned, the column macOS uses. Fixed rather than
                 sized to the longest label on the page: the labels then line up across
                 pages as well as down one, which is what makes the whole window read as
                 one form rather than six. -->
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="180" />
                <!-- 13, macOS's body size, not WinUI's 14. Every control on the page is
                     set to 13 for the same reason: the form has to read as one form, and
                     a label a point smaller than the box beside it reads as a mistake. -->
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Anything sitting in a row beside a label: matched to the label rather than
                 left at WinUI's default. -->
            <Style x:Key="RowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Indented to where the controls start, so a caption reads as belonging to
                 the control above it rather than to the label beside it. -->
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Margin" Value="188,0,0,0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A control with no label of its own: a tick box says what it is itself. -->
            <Style x:Key="Unlabelled" TargetType="CheckBox">
                <Setter Property="Margin" Value="188,0,0,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="Section" TargetType="StackPanel">
                <Setter Property="Spacing" Value="6" />
            </Style>
        </Grid.Resources>

        <!-- The pages behind a row of large icons with their names beneath, centred: an
             NSToolbar in preference style, which is what macshot's settings window has.
             A ListView rather than a NavigationView because the label belongs under the
             icon and NavigationView's top mode puts it beside — and because selection,
             keyboard traversal and narration are the ListView's job, not this window's. -->
        <ListView
            x:Name="Tabs"
            Margin="0,8,0,4"
            HorizontalAlignment="Center"
            SelectionMode="Single"
            SelectionChanged="Tabs_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListViewItem Tag="general" IsSelected="True">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="22" />
                    <TextBlock Text="General" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="capture">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" FontSize="22" />
                    <TextBlock Text="Capture" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="shortcuts">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE144;" FontSize="22" />
                    <TextBlock Text="Shortcuts" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="tools">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="22" />
                    <TextBlock Text="Tools" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="recording">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="22" />
                    <TextBlock Text="Recording" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <!-- macshot's sixth tab, in macshot's place: after Recording and before
                 About. Collapsed in the offline build, which has nothing to upload
                 with. -->
            <ListViewItem x:Name="UploadsTab" Tag="uploads">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE898;" FontSize="22" />
                    <TextBlock Text="Uploads" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="about">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="22" />
                    <TextBlock Text="About" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- All six pages exist at once and one is shown. A Frame would rebuild the page
             on every click, and a change on any page writes every page — one that has been
             navigated away from must still hold what was typed into it. -->
        <Grid Grid.Row="1" Padding="20,16,20,16">
            <!-- Appearance and the settings file, which is what macshot's General page
                 holds that this port has: it has no language of its own to pick, nothing
                 to launch at login and no updater to point at a channel. -->
            <ScrollViewer x:Name="GeneralPage">
                <StackPanel Spacing="20">
                    <!-- macshot's order on this tab, section for section:
                         Language, Application, Appearance, Settings Backup
                         (SettingsWindowController.swift:500–508). The headings carry
                         macshot's own strings so they resolve against its translations —
                         "UPDATES" matched nothing, "Application" matches every language
                         the Mac app ships. -->
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Language" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Language:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="LanguageBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="Restart the app to fully apply the new language."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Application" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="LaunchAtLoginCheck"
                            Content="Launch at login"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="HideTrayIconCheck"
                            Content="Hide menu bar icon"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Hotkeys still work. To show the icon again, re-launch macshot."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="AutomaticUpdatesCheck"
                            Content="Check for updates automatically"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="BetaUpdatesCheck"
                            Content="Check for beta updates"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Theme:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="ThemeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <!-- No label, because macshot's colour wells have none: they
                                 sit indented under Theme, and each one is named by the
                                 caption beneath it (SettingsWindowController.swift:543). -->
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <StackPanel x:Name="ToolbarColorRow" Orientation="Horizontal" Spacing="8" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Back to macshot's colours" FontSize="13" Click="ResetToolbarColors_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Settings Backup" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Export Settings…" FontSize="13" Click="ExportSettings_Click" />
                                <Button Content="Import Settings…" FontSize="13" Click="ImportSettings_Click" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Show the settings file" FontSize="13" Click="ShowSettingsFile_Click" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SettingsPathText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CapturePage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Capture" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="RememberSelectionCheck"
                            Content="Offer the last selection again"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="HideInstructionsCheck"
                            Content="Hide capture instructions"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="SelectionShadowCheck"
                            Content="Disable shadow outside selection"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="CaptureSoundCheck"
                            Content="Play sound on capture"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="ThumbnailCheck"
                            Content="Show floating thumbnail after capture"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="  Dismiss after:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="ThumbnailSecondsBox"
                                Width="120"
                                FontSize="13"
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="seconds" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Position:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="ThumbnailCornerBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="  Preview size:" Style="{StaticResource RowLabel}" />
                            <Slider
                                x:Name="ThumbnailScaleSlider"
                                Width="180"
                                Minimum="50"
                                Maximum="200"
                                StepFrequency="5"
                                TickFrequency="25"
                                ValueChanged="ThumbnailScale_Changed" />
                            <TextBlock x:Name="ThumbnailScaleReading" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="CaptureCursorCheck"
                            Content="Capture mouse cursor in screenshot"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <!-- No delay row. macshot sets the capture delay from the menu bar's
                             "Capture Delay" submenu and nowhere else (AppDelegate.swift:717),
                             and the tray menu here offers the same five choices. A second
                             control for one setting let the two disagree: the submenu offers
                             None, this box could not go below one second, and it could reach
                             values the submenu has no tick for. -->
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Output" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Save folder:" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="DirectoryBox" FontSize="13" Width="240" PlaceholderText="Pictures\Macshot" IsReadOnly="True" />
                            <Button Content="Browse…" FontSize="13" Click="Browse_Click" />
                            <Button Content="Reset" FontSize="13" Click="ResetDirectory_Click" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Filename:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="TemplateBox"
                                FontSize="13"
                                Width="240"
                                TextChanged="Template_TextChanged"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <!-- What the template resolves to right now. A template is the one
                             setting whose effect is invisible until a file has already been
                             written under the wrong name. -->
                        <TextBlock x:Name="TemplatePreview" Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Image format:" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="FormatBox" FontSize="13" Width="160" SelectionChanged="Format_SelectionChanged" />
                        </StackPanel>
                        <StackPanel x:Name="QualityPanel" Style="{StaticResource Row}">
                            <TextBlock Text="Quality:" Style="{StaticResource RowLabel}" />
                            <Slider
                                x:Name="QualitySlider"
                                Width="240"
                                Minimum="1"
                                Maximum="100"
                                StepFrequency="1"
                                ValueChanged="Setting_SliderChanged" />
                        </StackPanel>
                        <!-- One list rather than the two tick boxes this page used to
                             have. They said the same four things, but a pair of boxes
                             asks the reader to work out what both of them off means. -->
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Enter / Quick Capture:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="QuickCaptureBox"
                                FontSize="13"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <CheckBox
                            x:Name="QuickCaptureEditorCheck"
                            Content="Also open in Editor"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="History size:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="HistorySizeBox"
                                Width="120"
                                FontSize="13"
                                Minimum="0"
                                Maximum="200"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="captures" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="HistoryUnlimitedCheck"
                            Content="Unlimited"
                            Style="{StaticResource Unlabelled}"
                            Checked="HistoryUnlimited_Toggled"
                            Unchecked="HistoryUnlimited_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Clear History" FontSize="13" Click="ClearHistory_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- No translation section. macshot only builds one when Apple's
                         on-device translation is available, and its only control is the
                         choice between that and Google (SettingsWindowController.swift:994).
                         Windows has no on-device translator, so there is no choice to
                         offer and nothing to configure. -->
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionHeading}" />
                        <!-- One row per shortcut, filled in code from macshot's own
                             list: the label, what it is bound to, and the two buttons
                             that take it off and put the default back. Written here as
                             twelve rows it would be the same three facts repeated in
                             three places, free to disagree. -->
                        <StackPanel x:Name="GlobalShortcutRows" Spacing="8" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Overlay / Editor Shortcuts" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="ShortcutTooltipsCheck"
                            Content="Show shortcuts in tooltips"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <!-- One row per shortcut, filled in code from the same list the
                             overlay reads: a tool added later gets a row without this page
                             being edited, and the two can never disagree about what is
                             bound. -->
                        <StackPanel x:Name="ToolShortcutRows" Spacing="8" Margin="0,6,0,0" />
                        <TextBlock
                            Text="Press a single key to assign it as the shortcut for that tool. These work when the overlay or editor is active."
                            Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Annotation Tools" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Hidden tools are removed from the bottom toolbar."
                            Style="{StaticResource Caption}" />
                        <!-- Filled in code from the toolbar's own list, so a tool added
                             later appears here without this page being edited. -->
                        <Grid x:Name="ToolToggles" Margin="188,4,0,0" ColumnDefinitions="*,*" RowSpacing="2" ColumnSpacing="12" />
                        <!-- No freehand smoothing row. macshot puts that choice on the
                             tool options row beside the pencil and nowhere else, which is
                             where this build already draws it, and a second copy here is
                             a second place for the same setting to be changed from. -->
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Bottom Toolbar Actions" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Hidden actions are removed from the bottom toolbar."
                            Style="{StaticResource Caption}" />
                        <!-- Both lists are filled in code from ToolbarCustomActions, for the
                             reason the tool list above is: the strip and this page then
                             cannot disagree about what exists. -->
                        <Grid x:Name="BottomActionToggles" Margin="188,4,0,0" ColumnDefinitions="*,*" RowSpacing="2" ColumnSpacing="12" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Right Toolbar Actions" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Hidden actions are removed from the right toolbar."
                            Style="{StaticResource Caption}" />
                        <Grid x:Name="RightActionToggles" Margin="188,4,0,0" ColumnDefinitions="*,*" RowSpacing="2" ColumnSpacing="12" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RecordingPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <!-- macshot's three sections in macshot's order: Output, Behavior,
                         Webcam (SettingsWindowController.swift:1547–1646). The frame rate
                         sits at the top of Output there rather than under a heading of its
                         own, and what macshot puts on the recording strip — the click ring,
                         the audio pair, the webcam switch — is not repeated here. The strip
                         offers all of them (ToolbarActions.RecordingItems), and a setting
                         with two homes is a setting that can disagree with itself. -->
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Output" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Frame rate:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="RecordingFrameRateBox"
                                FontSize="13"
                                Width="160"
                                SelectionChanged="Setting_SelectionChanged" />
                            <TextBlock Text="fps" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <!-- Kept, unlike the strip's switches: macshot has no second place
                             to choose a format or a GIF's frame rate, so removing these
                             would remove the settings rather than de-duplicate them. -->
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Format:" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="RecordingFormatBox" FontSize="13" Width="160" SelectionChanged="RecordingFormat_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="GIF:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="GifFrameRateBox"
                                Width="120"
                                FontSize="13"
                                Minimum="2"
                                Maximum="30"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="fps" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Save folder:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="RecordingDirectoryBox"
                                FontSize="13"
                                Width="240"
                                PlaceholderText="Same as screenshots"
                                IsReadOnly="True" />
                            <Button Content="Browse…" FontSize="13" Click="BrowseRecordings_Click" />
                            <Button Content="Clear" FontSize="13" Click="ClearRecordingDirectory_Click" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Filename:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="RecordingTemplateBox"
                                FontSize="13"
                                Width="240"
                                TextChanged="RecordingTemplate_TextChanged"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <TextBlock x:Name="RecordingTemplatePreview" Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Behavior" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="When done:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="RecordingOnStopBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <CheckBox
                            x:Name="HideRecordingHudCheck"
                            Content="Hide recording controls"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Stop recording from the menu bar icon instead."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="RecordedRegionBorderCheck"
                            Content="Outline what is being recorded"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <!-- The strip switches keystrokes on and off but cannot say which
                             kind, so the mode stays here. -->
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Keystrokes:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="KeystrokeModeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Webcam" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Position:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="WebcamCornerBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Size:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="WebcamSizeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Shape:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="WebcamShapeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- macshot's Uploads tab, section for section: Upload Provider, Google
                 Drive, S3-Compatible Storage, imgbb, Upload History. Its captions are
                 macshot's own sentences, which is what its translations are keyed by. -->
            <ScrollViewer x:Name="UploadsPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Upload Provider" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Provider:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="UploadProviderBox"
                                FontSize="13"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <CheckBox
                            x:Name="UploadConfirmBox"
                            Content="Confirm before upload"
                            FontSize="13"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Google Drive" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Account:" Style="{StaticResource RowLabel}" />
                            <TextBlock
                                x:Name="DriveAccountText"
                                FontSize="13"
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Style="{StaticResource RowLabel}" />
                            <Button x:Name="DriveSignInButton" FontSize="13" Click="DriveSignIn_Click" />
                        </StackPanel>
                        <TextBlock
                            Text="Files are uploaded to a &quot;macshot&quot; folder in your Google Drive. Everything stays private — nothing is shared publicly."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="S3-Compatible Storage" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Endpoint:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="S3EndpointBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="https://abc123.r2.cloudflarestorage.com"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Region:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="S3RegionBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="auto"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Bucket:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="S3BucketBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="my-bucket"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Access Key:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="S3AccessKeyBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="AKIAIOSFODNN7EXAMPLE"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Secret Key:" Style="{StaticResource RowLabel}" />
                            <!-- A password box, as macshot uses a secure field here. The
                                 settings window is opened in front of other people often
                                 enough that a secret in plain sight is a real leak. -->
                            <PasswordBox
                                x:Name="S3SecretKeyBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Public URL:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="S3PublicUrlBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="https://cdn.example.com"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <TextBlock
                            Text="Base URL for public access. If empty, the S3 endpoint URL is used (may not be publicly accessible)."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Path Prefix:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="S3PathPrefixBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="screenshots/"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <!-- macshot's Test Connection, in macshot's place: after the path
                             prefix and before the note about which services this works
                             with (SettingsWindowController.swift:1835). Six fields have to
                             be right together, and until something has been written to the
                             bucket none of them has been checked at all. -->
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button x:Name="S3TestButton" Content="Test Connection" FontSize="13" Click="TestS3_Click" />
                            <TextBlock
                                x:Name="S3TestStatus"
                                FontSize="11"
                                VerticalAlignment="Center"
                                TextWrapping="Wrap"
                                MaxWidth="320"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <TextBlock
                            Text="Works with AWS S3, Cloudflare R2, MinIO, DigitalOcean Spaces, Backblaze B2, and other S3-compatible services. Supports images and videos."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="imgbb" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="API key:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="ImgbbKeyBox"
                                FontSize="13"
                                Width="300"
                                FontFamily="Consolas"
                                PlaceholderText="Leave empty to use default"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <TextBlock
                            Text="A shared key is included — get your own free key at imgbb.com/api if you hit rate limits. Images only (no video support)."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Upload History" Style="{StaticResource SectionHeading}" />
                        <!-- Rebuilt whenever the page is shown rather than bound: the list
                             changes from outside this window, every time something is
                             uploaded. -->
                        <StackPanel x:Name="UploadHistoryList" Spacing="6" />
                        <TextBlock
                            x:Name="UploadHistoryEmpty"
                            Text="No uploads yet."
                            Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <!-- macshot's About page, in macshot's order and centred as its is:
                         icon, name, version, what it is, licence, Copy Screen Info
                         (SettingsWindowController.swift:1928–1979). The name is filled in
                         at run time because the offline build calls itself something
                         else. -->
                    <StackPanel Style="{StaticResource Section}" HorizontalAlignment="Center" Spacing="8">
                        <Image
                            x:Name="AboutIcon"
                            Width="80"
                            Height="80"
                            HorizontalAlignment="Center" />
                        <TextBlock
                            x:Name="AboutNameText"
                            HorizontalAlignment="Center"
                            FontSize="22"
                            FontWeight="Bold" />
                        <TextBlock
                            x:Name="VersionText"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="A screenshot and annotation tool. This is the Windows build of the macOS app of the same name, with the same tools, the same toolbar and the same shortcuts."
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="440"
                            Margin="0,12,0,0"
                            FontSize="13" />
                        <TextBlock
                            x:Name="AboutOfflineNote"
                            TextWrapping="Wrap"
                            TextAlignment="Center"
                            MaxWidth="440"
                            FontSize="12"
                            Visibility="Collapsed"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="Licensed under the GPLv3"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                        <Button
                            x:Name="ScreenInfoButton"
                            Content="Copy Screen Info"
                            HorizontalAlignment="Center"
                            Margin="0,12,0,0"
                            FontSize="11"
                            Click="CopyScreenInfo_Click" />
                        <TextBlock
                            Text="Copies display and capture diagnostics to clipboard"
                            HorizontalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="VerboseLoggingCheck"
                            Content="Write a detailed log"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Open the log folder" FontSize="13" Click="OpenLogFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The same credit line the macOS settings window ends with. There is no Save
             button on either: a setting takes effect when it is changed, so a button that
             confirmed it would be a second step for something already done — and one that
             looked unpressed after a change would say the change had not been kept.
             The middle column is where a write that failed says so, which is the only
             thing about a setting left worth reporting. -->
        <Grid
            Grid.Row="2"
            Padding="20,6,20,8"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <!-- Filled in code: macshot translates "Made by" and leaves the name alone,
                 so the line cannot be one literal without losing its translation. -->
            <TextBlock
                x:Name="MadeByText"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton
                Grid.Column="2"
                Content="github.com/sw33tLie/macshot"
                NavigateUri="https://github.com/sw33tLie/macshot"
                FontSize="11"
                Padding="4,0" />
        </Grid>
    </Grid>
</Window>
