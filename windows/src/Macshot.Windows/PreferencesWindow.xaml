<Window
    x:Class="Macshot.Windows.PreferencesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Macshot.Windows"
    Title="Macshot Settings">
    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" RowDefinitions="Auto,*,Auto">
        <Grid.Resources>
            <!-- The three shapes every settings page here is built out of, which are the
                 three the macOS window is built out of: a small capitalised heading above
                 each group, a fixed-width right-aligned label beside each control, and a
                 dimmer caption under the ones that need explaining. macshot on Windows is
                 that product written in another language, and someone who knows the shape
                 of one window must recognise the other. -->

            <!-- Written as macshot writes it and put into capitals at runtime, not in the
                 markup: the capitals were what broke the translation, since "OUTPUT" is
                 not a key macshot ships and "Output" is. See ShoutTheSectionHeadings. -->
            <Style x:Key="SectionHeading" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <!-- 4 here plus the section's own 6 is the 10 macOS puts after a heading. -->
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- 180 wide and right-aligned, the column macOS uses. Fixed rather than
                 sized to the longest label on the page: the labels then line up across
                 pages as well as down one, which is what makes the whole window read as
                 one form rather than six. -->
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="Width" Value="180" />
                <!-- 13, macOS's body size, not WinUI's 14. Every control on the page is
                     set to 13 for the same reason: the form has to read as one form, and
                     a label a point smaller than the box beside it reads as a mistake. -->
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Anything sitting in a row beside a label: matched to the label rather than
                 left at WinUI's default. -->
            <Style x:Key="RowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- Indented to where the controls start, so a caption reads as belonging to
                 the control above it rather than to the label beside it. -->
            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Margin" Value="188,0,0,0" />
                <Setter Property="FontSize" Value="10" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- A control with no label of its own: a tick box says what it is itself. -->
            <Style x:Key="Unlabelled" TargetType="CheckBox">
                <Setter Property="Margin" Value="188,0,0,0" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinWidth" Value="0" />
            </Style>

            <Style x:Key="Row" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="8" />
            </Style>

            <Style x:Key="Section" TargetType="StackPanel">
                <Setter Property="Spacing" Value="6" />
            </Style>
        </Grid.Resources>

        <!-- The pages behind a row of large icons with their names beneath, centred: an
             NSToolbar in preference style, which is what macshot's settings window has.
             A ListView rather than a NavigationView because the label belongs under the
             icon and NavigationView's top mode puts it beside — and because selection,
             keyboard traversal and narration are the ListView's job, not this window's. -->
        <ListView
            x:Name="Tabs"
            Margin="0,8,0,4"
            HorizontalAlignment="Center"
            SelectionMode="Single"
            SelectionChanged="Tabs_SelectionChanged">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>

            <ListViewItem Tag="general" IsSelected="True">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE713;" FontSize="22" />
                    <TextBlock Text="General" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="capture">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE722;" FontSize="22" />
                    <TextBlock Text="Capture" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="shortcuts">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE144;" FontSize="22" />
                    <TextBlock Text="Shortcuts" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="tools">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE70F;" FontSize="22" />
                    <TextBlock Text="Tools" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="recording">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE714;" FontSize="22" />
                    <TextBlock Text="Recording" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
            <ListViewItem Tag="about">
                <StackPanel Width="72" Padding="0,4">
                    <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xE946;" FontSize="22" />
                    <TextBlock Text="About" FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0" />
                </StackPanel>
            </ListViewItem>
        </ListView>

        <!-- All six pages exist at once and one is shown. A Frame would rebuild the page
             on every click, and a change on any page writes every page — one that has been
             navigated away from must still hold what was typed into it. -->
        <Grid Grid.Row="1" Padding="20,16,20,16">
            <!-- Appearance and the settings file, which is what macshot's General page
                 holds that this port has: it has no language of its own to pick, nothing
                 to launch at login and no updater to point at a channel. -->
            <ScrollViewer x:Name="GeneralPage">
                <StackPanel Spacing="20">
                    <!-- macshot's order on this tab, section for section:
                         Language, Application, Appearance, Settings Backup
                         (SettingsWindowController.swift:500–508). The headings carry
                         macshot's own strings so they resolve against its translations —
                         "UPDATES" matched nothing, "Application" matches every language
                         the Mac app ships. -->
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Language" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Language:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="LanguageBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="Windows opened after this takes the new language. macshot's own translations are used, so a language contributed to the Mac app arrives here too."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Application" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="LaunchAtLoginCheck"
                            Content="Launch at Login"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="HideTrayIconCheck"
                            Content="Hide Menu Bar Icon"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Shortcuts still work. To show the icon again, restart macshot."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="AutomaticUpdatesCheck"
                            Content="Check for updates automatically"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="BetaUpdatesCheck"
                            Content="Check for beta updates"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="This build has no updater in it yet, so nothing checks. What you choose here is kept and will be honoured by the first build that does."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Appearance" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Theme:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="ThemeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="Applies to macshot's own windows. The capture toolbar keeps its dark palette either way — it is drawn over a screenshot rather than inside a window, so following the system theme would make it disappear into half the captures anyone takes."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Toolbar:" Style="{StaticResource RowLabel}" />
                            <StackPanel x:Name="ToolbarColorRow" Orientation="Horizontal" Spacing="8" />
                        </StackPanel>
                        <TextBlock
                            Text="The toolbar is drawn over a screenshot rather than inside a window, so it cannot follow the system theme without disappearing into half the captures anyone takes. Hover and press are worked out from the accent and the icon colour, so no combination can make the buttons unreadable."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Back to macshot's colours" FontSize="13" Click="ResetToolbarColors_Click" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Settings Backup" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Export Settings…" FontSize="13" Click="ExportSettings_Click" />
                                <Button Content="Import Settings…" FontSize="13" Click="ImportSettings_Click" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock
                            Text="Export your preferences to a file to move them to another PC or a clean install. Your save folder, the last selection, and screenshot history are not included."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Show the settings file" FontSize="13" Click="ShowSettingsFile_Click" />
                        </StackPanel>
                        <TextBlock
                            x:Name="SettingsPathText"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="CapturePage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Capture" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="RememberSelectionCheck"
                            Content="Offer the last selection again"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="The next capture draws the previous region on the display it was taken from, and Enter takes it again. Off by default, because a selection that reappears on its own is a surprise until you know the setting exists."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="HideInstructionsCheck"
                            Content="Hide the capture instructions"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Takes the standing instruction off the overlay for someone who has read it. What the overlay has to report — a sampled colour, a ruler's reading, a failure — still appears. Window snap keeps its Tab toggle; only the line that names it goes."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="ThumbnailCheck"
                            Content="Show the floating thumbnail after a capture"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Dismiss it after:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="ThumbnailSecondsBox"
                                Width="120"
                                FontSize="13"
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="seconds" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Position:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="ThumbnailCornerBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Preview size:" Style="{StaticResource RowLabel}" />
                            <Slider
                                x:Name="ThumbnailScaleSlider"
                                Width="180"
                                Minimum="50"
                                Maximum="200"
                                StepFrequency="5"
                                TickFrequency="25"
                                ValueChanged="ThumbnailScale_Changed" />
                            <TextBlock x:Name="ThumbnailScaleReading" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Delayed capture:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="DelaySecondsBox"
                                Width="120"
                                FontSize="13"
                                Minimum="1"
                                Maximum="60"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="seconds" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <TextBlock
                            Text="Used by &quot;Capture area after a delay&quot; in the notification-area menu, for capturing a menu or a hover state that would close if you reached for macshot. The keyboard shortcut stays immediate."
                            Style="{StaticResource Caption}" />
                        <TextBlock
                            Text="On the overlay: scroll to zoom in on what you are capturing, middle-drag to pan, Ctrl+0 for actual size."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Output" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Save folder:" Style="{StaticResource RowLabel}" />
                            <TextBox x:Name="DirectoryBox" FontSize="13" Width="240" PlaceholderText="Pictures\Macshot" IsReadOnly="True" />
                            <Button Content="Browse" FontSize="13" Click="Browse_Click" />
                            <Button Content="Reset" FontSize="13" Click="ResetDirectory_Click" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="File name:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="TemplateBox"
                                FontSize="13"
                                Width="240"
                                TextChanged="Template_TextChanged"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <!-- What the template resolves to right now. A template is the one
                             setting whose effect is invisible until a file has already been
                             written under the wrong name. -->
                        <TextBlock x:Name="TemplatePreview" Style="{StaticResource Caption}" />
                        <TextBlock Text="Tokens: {yyyy} {yy} {MM} {dd} {HH} {mm} {ss}" Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Format:" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="FormatBox" FontSize="13" Width="160" SelectionChanged="Format_SelectionChanged" />
                        </StackPanel>
                        <StackPanel x:Name="QualityPanel" Style="{StaticResource Row}">
                            <TextBlock Text="Quality:" Style="{StaticResource RowLabel}" />
                            <Slider
                                x:Name="QualitySlider"
                                Width="240"
                                Minimum="1"
                                Maximum="100"
                                StepFrequency="1"
                                ValueChanged="Setting_SliderChanged" />
                        </StackPanel>
                        <CheckBox
                            x:Name="ClipboardCheck"
                            Content="Copy to the clipboard"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="AutoSaveCheck"
                            Content="Save to the save folder"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="The toolbar's copy, save and pin buttons each mean one of these on their own, whatever is ticked here."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Keep the last:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="HistorySizeBox"
                                Width="120"
                                FontSize="13"
                                Minimum="0"
                                Maximum="200"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="captures" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <CheckBox
                            x:Name="HistoryUnlimitedCheck"
                            Content="Keep every capture"
                            Style="{StaticResource Unlabelled}"
                            Checked="HistoryUnlimited_Toggled"
                            Unchecked="HistoryUnlimited_Toggled" />
                        <TextBlock
                            Text="Kept under macshot's own data folder, separately from the save folder, and offered in the notification-area menu. Zero keeps none, and keeping every capture wins over a zero rather than deleting them all."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Clear history now" FontSize="13" Click="ClearHistory_Click" />
                        </StackPanel>
                    </StackPanel>

                    <!-- No translation section. macshot only builds one when Apple's
                         on-device translation is available, and its only control is the
                         choice between that and Google (SettingsWindowController.swift:994).
                         Windows has no on-device translator, so there is no choice to
                         offer and nothing to configure. -->
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ShortcutsPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Keyboard Shortcuts" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Capture area:" Style="{StaticResource RowLabel}" />
                            <local:HotkeyBox x:Name="CaptureAreaHotkeyBox" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Capture all screens:" Style="{StaticResource RowLabel}" />
                            <local:HotkeyBox x:Name="CaptureAllScreensHotkeyBox" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Record screen:" Style="{StaticResource RowLabel}" />
                            <local:HotkeyBox x:Name="RecordScreenHotkeyBox" />
                        </StackPanel>
                        <TextBlock
                            Text="Click a shortcut and press the keys. At least one of Ctrl, Alt, Shift or Win is required — a shortcut with no modifier would swallow that key in every program on the machine. The settings file stores them as text, written like Ctrl+Shift+X."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Overlay Shortcuts" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Enter takes the capture • Esc gives it up • Tab turns window snap on and off • F takes the whole display • Ctrl+Z and Ctrl+Y undo and redo • Delete removes the selected mark • the arrow keys nudge the region, ten pixels at a time with Shift • right-click opens the colour ring."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Overlay / Editor Shortcuts" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="ShortcutTooltipsCheck"
                            Content="Show shortcuts in tooltips"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <!-- One row per shortcut, filled in code from the same list the
                             overlay reads: a tool added later gets a row without this page
                             being edited, and the two can never disagree about what is
                             bound. -->
                        <StackPanel x:Name="ToolShortcutRows" Spacing="8" Margin="0,6,0,0" />
                        <TextBlock
                            Text="Press a single key to assign it as the shortcut for that tool. These work when the overlay or editor is active."
                            Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="ToolsPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Annotation Tools" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Unticked tools are taken off the strip. Nothing is lost by hiding one, and the same choice is on the right-click menu of any tool button."
                            Style="{StaticResource Caption}" />
                        <!-- Filled in code from the toolbar's own list, so a tool added
                             later appears here without this page being edited. -->
                        <StackPanel x:Name="ToolToggles" Margin="188,4,0,0" Spacing="2" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Freehand:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="PencilSmoothingBox"
                                FontSize="13"
                                Width="160"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="What happens to a pencil or highlighter stroke once you let go. A path sampled from a mouse is a staircase: Smooth rounds its corners off, Refined evens out the shake along it as well, and None leaves the points exactly where the pointer went, for tracing something. The same choice sits under the pencil on the toolbar."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Bottom Toolbar Actions" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Hidden actions are removed from the bottom toolbar."
                            Style="{StaticResource Caption}" />
                        <!-- Both lists are filled in code from ToolbarCustomActions, for the
                             reason the tool list above is: the strip and this page then
                             cannot disagree about what exists. -->
                        <StackPanel x:Name="BottomActionToggles" Margin="188,4,0,0" Spacing="2" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Right Toolbar Actions" Style="{StaticResource SectionHeading}" />
                        <TextBlock
                            Text="Hidden actions are removed from the right toolbar."
                            Style="{StaticResource Caption}" />
                        <StackPanel x:Name="RightActionToggles" Margin="188,4,0,0" Spacing="2" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="RecordingPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Output" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Format:" Style="{StaticResource RowLabel}" />
                            <ComboBox x:Name="RecordingFormatBox" FontSize="13" Width="160" SelectionChanged="RecordingFormat_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="GIF is written smaller and slower than MP4, because every GIF frame is a whole image."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Save folder:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="RecordingDirectoryBox"
                                FontSize="13"
                                Width="240"
                                PlaceholderText="Same as screenshots"
                                IsReadOnly="True" />
                            <Button Content="Browse" FontSize="13" Click="BrowseRecordings_Click" />
                            <Button Content="Clear" FontSize="13" Click="ClearRecordingDirectory_Click" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="File name:" Style="{StaticResource RowLabel}" />
                            <TextBox
                                x:Name="RecordingTemplateBox"
                                FontSize="13"
                                Width="240"
                                TextChanged="RecordingTemplate_TextChanged"
                                LostFocus="Setting_LostFocus" />
                        </StackPanel>
                        <TextBlock x:Name="RecordingTemplatePreview" Style="{StaticResource Caption}" />
                        <TextBlock
                            Text="Its own template, so a folder of recordings and screenshots can still be told apart by name. The same tokens as above."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Frame Rate" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Video:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="RecordingFrameRateBox"
                                FontSize="13"
                                Width="160"
                                SelectionChanged="Setting_SelectionChanged" />
                            <TextBlock Text="fps" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <TextBlock
                            Text="30 is what a screen recording is normally taken at. 60 and 120 are for showing something that moves quickly, and cost roughly their multiple of the file size."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="GIF:" Style="{StaticResource RowLabel}" />
                            <NumberBox
                                x:Name="GifFrameRateBox"
                                Width="120"
                                FontSize="13"
                                Minimum="2"
                                Maximum="30"
                                SpinButtonPlacementMode="Compact"
                                ValueChanged="Setting_NumberChanged" />
                            <TextBlock Text="fps" Style="{StaticResource RowText}" />
                        </StackPanel>
                        <TextBlock
                            Text="Kept separate because it answers a different question: not how smooth the recording should be, but how large a GIF may get before whatever it is being sent to refuses it."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Behavior" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="RecordedRegionBorderCheck"
                            Content="Outline what is being recorded"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="A frame in the toolbar's accent colour, laid outside the recorded rectangle so it is never in the file. Once the recording panel has been dragged out of the way, it is the only thing left saying what is being recorded."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="ClickHighlightCheck"
                            Content="Show a ring where you click"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="A yellow ring blooms out of every click and fades in a third of a second. Unlike the outline this one is inside the recording, which is the point — a viewer otherwise sees the pointer move and something happen, with nothing in between."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="KeystrokeCheck"
                            Content="Show Keystrokes"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Keystrokes:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="KeystrokeModeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="A dark pill at the foot of the recorded region, holding what was typed for a second and a half. Shortcuts only leaves ordinary typing alone, so a recording of somebody answering an email is not a transcript of the email."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Sound" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="RecordSystemAudioCheck"
                            Content="Record system audio"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <CheckBox
                            x:Name="RecordMicAudioCheck"
                            Content="Record microphone"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Both off by default, because sound nobody asked for is a surprise in a file that gets shared. Turning both on mixes them into one soundtrack. GIF has nowhere to put sound and ignores this."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="When Done" Style="{StaticResource SectionHeading}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="When done:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="RecordingOnStopBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="A recording always goes to a file — minutes of video do not belong on the clipboard — so this is what happens next. macshot's third choice is its video editor, which this build has not got yet."
                            Style="{StaticResource Caption}" />
                        <CheckBox
                            x:Name="HideRecordingHudCheck"
                            Content="Hide recording controls"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Stop recording from the menu bar icon instead. Escape stops it too, and with the panel gone the choice above is the only thing that says where the recording went."
                            Style="{StaticResource Caption}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Webcam" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="WebcamCheck"
                            Content="Webcam Overlay"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Position:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="WebcamCornerBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Size:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="WebcamSizeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="Shape:" Style="{StaticResource RowLabel}" />
                            <ComboBox
                                x:Name="WebcamShapeBox"
                                Width="240"
                                SelectionChanged="Setting_SelectionChanged" />
                        </StackPanel>
                        <TextBlock
                            Text="The camera in a corner of the recorded region, 12 clear of its edges under a white ring. Unlike everything else macshot puts on screen while recording, this one is meant to be in the file. Off by default, and asked for again on the strip before each recording."
                            Style="{StaticResource Caption}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <ScrollViewer x:Name="AboutPage" Visibility="Collapsed">
                <StackPanel Spacing="20">
                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="macshot" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <TextBlock
                            Text="A screenshot and annotation tool. This is the Windows build of the macOS app of the same name, with the same tools, the same toolbar and the same shortcuts."
                            TextWrapping="Wrap"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Style="{StaticResource Section}">
                        <TextBlock Text="Diagnostics" Style="{StaticResource SectionHeading}" />
                        <CheckBox
                            x:Name="VerboseLoggingCheck"
                            Content="Write a detailed log"
                            Style="{StaticResource Unlabelled}"
                            Checked="Setting_Toggled"
                            Unchecked="Setting_Toggled" />
                        <TextBlock
                            Text="Records each step — which display, which capture backend, what size, which branch — next to the settings file. Turn it on before reproducing a fault, then attach the log. It never contains the text that was recognized."
                            Style="{StaticResource Caption}" />
                        <StackPanel Style="{StaticResource Row}">
                            <TextBlock Text="" Style="{StaticResource RowLabel}" />
                            <Button Content="Open the log folder" FontSize="13" Click="OpenLogFolder_Click" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- The same credit line the macOS settings window ends with. There is no Save
             button on either: a setting takes effect when it is changed, so a button that
             confirmed it would be a second step for something already done — and one that
             looked unpressed after a change would say the change had not been kept.
             The middle column is where a write that failed says so, which is the only
             thing about a setting left worth reporting. -->
        <Grid
            Grid.Row="2"
            Padding="20,6,20,8"
            ColumnDefinitions="Auto,*,Auto"
            ColumnSpacing="8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <TextBlock
                Text="Made by sw33tLie"
                VerticalAlignment="Center"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="1"
                VerticalAlignment="Center"
                TextWrapping="Wrap"
                FontSize="11"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <HyperlinkButton
                Grid.Column="2"
                Content="github.com/sw33tLie/macshot"
                NavigateUri="https://github.com/sw33tLie/macshot"
                FontSize="11"
                Padding="4,0" />
        </Grid>
    </Grid>
</Window>
