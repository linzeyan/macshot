<Window
    x:Class="Macshot.Windows.RecordingHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Recording">
    <!-- macshot's pill: 164 x 32, the toolbar's own background at 94% behind a hairline
         at the icon colour's 10%. Dark whatever the system theme is, like every other
         piece of macshot's chrome, so every foreground here is set rather than
         inherited. -->
    <Grid
        x:Name="HudRoot"
        Background="#F01F1F1F"
        BorderBrush="#1AFFFFFF"
        BorderThickness="0.5"
        PointerPressed="HudRoot_PointerPressed"
        PointerMoved="HudRoot_PointerMoved"
        PointerReleased="HudRoot_PointerReleased">

        <!-- Fixed positions rather than a StackPanel, because these are macshot's own
             numbers — 6 of padding, 24 buttons, 2 between them, 6 on to the dot, 3 on to
             the reading — and because the reading must not shove the buttons sideways as
             the minutes tick over. -->
        <Canvas x:Name="RunningLayer">
            <Border
                x:Name="StopButton"
                Canvas.Left="6"
                Canvas.Top="4"
                Width="24"
                Height="24"
                CornerRadius="6"
                Background="Transparent"
                PointerPressed="Stop_PointerPressed">
                <Rectangle
                    Width="11"
                    Height="11"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    Fill="#FFFFFF"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center" />
            </Border>

            <Border
                x:Name="PauseButton"
                Canvas.Left="32"
                Canvas.Top="4"
                Width="24"
                Height="24"
                CornerRadius="6"
                Background="Transparent"
                PointerPressed="Pause_PointerPressed">
                <!-- Two bars while running, a triangle while held. Both are built once
                     and one is shown, so a press changes nothing but a visibility.

                     Both carry their own size and their own centring rather than leaning
                     on the default Stretch to place them. A Shape's Stretch is None
                     unless it is a Rectangle or an Ellipse, so the triangle's points were
                     laid out from the corner of the 24 button while the bars, which are
                     Rectangles with a panel of their own around them, were centred in it
                     — which is why the triangle sat above the square beside it. -->
                <Grid>
                    <StackPanel
                        x:Name="PauseBars"
                        Orientation="Horizontal"
                        Spacing="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Rectangle Width="3.5" Height="12" Fill="#FFFFFF" />
                        <Rectangle Width="3.5" Height="12" Fill="#FFFFFF" />
                    </StackPanel>
                    <Polygon
                        x:Name="ResumeTriangle"
                        Points="0,0 11,6 0,12"
                        Width="11"
                        Height="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Fill="#FFFFFF"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!-- The dot every recorder has, and the one part of the panel readable from
                 across the room. Orange while held, as macshot's is. -->
            <Ellipse
                x:Name="RecordDot"
                Canvas.Left="62"
                Canvas.Top="13"
                Width="7"
                Height="7"
                Fill="#FF3B30" />

            <TextBlock
                x:Name="ElapsedText"
                Canvas.Left="75"
                Canvas.Top="6"
                Text="00:00"
                FontSize="13"
                FontWeight="SemiBold"
                Foreground="#FFFFFF" />

            <!-- Three lines, which is what says a panel with no title bar can be moved.
                 macshot's is 20 wide and 6 in from the right of a 164 pill. -->
            <Canvas Canvas.Left="140" Canvas.Top="9">
                <Rectangle Width="16" Height="1.5" Fill="#59FFFFFF" />
                <Rectangle Canvas.Top="5" Width="16" Height="1.5" Fill="#59FFFFFF" />
                <Rectangle Canvas.Top="10" Width="16" Height="1.5" Fill="#59FFFFFF" />
            </Canvas>
        </Canvas>

        <!-- What the panel becomes for its last three seconds. macshot has no such state
             — a finished recording gets a toast instead — but video lands in neither the
             clipboard nor a thumbnail here, so this is the only thing that says the file
             exists and where. It is also why the window may grow once the recording is
             over, and never while it runs. -->
        <StackPanel
            x:Name="SavedLayer"
            Orientation="Horizontal"
            Spacing="8"
            Padding="12,0"
            VerticalAlignment="Center"
            Visibility="Collapsed">
            <TextBlock x:Name="SavedText" Foreground="#FFFFFF" VerticalAlignment="Center" />
            <TextBlock
                x:Name="SavedDuration"
                Foreground="#B0B0B0"
                FontSize="12"
                VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Window>
