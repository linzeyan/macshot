<Window
    x:Class="Macshot.Windows.VideoEditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="macshot Video Editor">
    <!-- macshot's window: the picture above, 172 of controls below, dark whatever the
         system theme is like the rest of this port's chrome. Dark is requested on the
         root rather than painted on, so the combo boxes and buttons inside come out
         light-on-dark too. -->
    <Grid Background="#FF1F1F1F" RequestedTheme="Dark">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MediaPlayerElement
            x:Name="Player"
            Grid.Row="0"
            AreTransportControlsEnabled="False"
            Stretch="Uniform" />

        <!-- A GIF is not a video to Windows any more than it is to AVFoundation: nothing
             will play it but an image control, which is what macshot falls back to as
             well. Shown in place of the player, and only for a GIF. -->
        <Image
            x:Name="GifView"
            Grid.Row="0"
            Stretch="Uniform"
            Visibility="Collapsed" />

        <!-- macshot's EffectsPreviewOverlayView: where a zoom, a censor or a caption goes
             on the picture, dragged on top of the player itself rather than typed as
             numbers. Only up while one of those three is selected on the band — a frame
             drawn over the video the rest of the time would read as part of the recording. -->
        <Canvas
            x:Name="RectOverlay"
            Grid.Row="0"
            Background="Transparent"
            Visibility="Collapsed"
            SizeChanged="RectOverlay_SizeChanged"
            PointerPressed="RectOverlay_PointerPressed"
            PointerMoved="RectOverlay_PointerMoved"
            PointerReleased="RectOverlay_PointerReleased"
            PointerCaptureLost="RectOverlay_PointerCaptureLost">
            <Rectangle
                x:Name="RectFrame"
                Stroke="#FFFFC74D"
                StrokeThickness="2"
                Fill="#1AFFFFFF" />
            <!-- One corner rather than macshot's eight handles: the other seven would each
                 need their own hit region on a surface this port cannot photograph to
                 check. Drag the middle to move it, this corner to resize it.

                 For a zoom the one corner is not a shortfall at all. Its window is locked to
                 the video's aspect — one fraction of the frame in both axes — so every
                 handle macshot draws sets the same single number, and eight of them would be
                 eight ways to say what this one says. -->
            <Rectangle
                x:Name="RectHandle"
                Width="12"
                Height="12"
                Fill="#FFFFC74D" />
        </Canvas>

        <StackPanel Grid.Row="1" Padding="16,10,16,12" Spacing="8">
            <StackPanel x:Name="TrimPanel" Spacing="8">
                <!-- The timeline: the whole recording as a track, the kept piece lit, a
                     handle at each end and the playhead over it. Drawn rather than
                     assembled from controls because macshot draws it, and because a
                     Slider cannot have two thumbs. -->
                <Canvas
                    x:Name="Timeline"
                    Height="56"
                    Background="Transparent"
                    PointerPressed="Timeline_PointerPressed"
                    PointerMoved="Timeline_PointerMoved"
                    PointerReleased="Timeline_PointerReleased"
                    PointerCaptureLost="Timeline_PointerCaptureLost">
                    <Rectangle x:Name="TimelineTrack" Height="40" Canvas.Top="8" RadiusX="6" RadiusY="6" Fill="#26FFFFFF" />
                    <Rectangle x:Name="TimelineKept" Height="40" Canvas.Top="8" Fill="#332F7CF6" />
                    <Rectangle x:Name="TrimStartHandle" Width="10" Height="40" Canvas.Top="8" RadiusX="3" RadiusY="3" Fill="#FF2F7CF6" />
                    <Rectangle x:Name="TrimEndHandle" Width="10" Height="40" Canvas.Top="8" RadiusX="3" RadiusY="3" Fill="#FF2F7CF6" />
                    <Rectangle x:Name="Playhead" Width="2" Height="48" Canvas.Top="4" Fill="#FFFFFFFF" />
                </Canvas>

                <!-- macshot's effects band, with all six of its effects. A pill per
                     segment: drag its middle to move it, an end to resize it, click it to
                     select it, and the box beside the band sets whatever that kind of
                     effect has to set. Pills are built in code rather than declared here
                     because there is one per segment and the band stacks them into rows.
                     The band is only there for an MP4 export, since nothing re-encodes a
                     GIF here. -->
                <StackPanel x:Name="EffectsPanel" Spacing="6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Canvas
                            x:Name="EffectsBand"
                            Grid.Column="0"
                            Height="26"
                            Background="#14FFFFFF"
                            PointerPressed="EffectsBand_PointerPressed"
                            PointerMoved="EffectsBand_PointerMoved"
                            PointerReleased="EffectsBand_PointerReleased"
                            PointerCaptureLost="EffectsBand_PointerCaptureLost">
                            <TextBlock
                                x:Name="BandHintText"
                                Canvas.Top="5"
                                FontSize="11"
                                Foreground="#8CFFFFFF"
                                IsHitTestVisible="False"
                                Text="Click to add effects" />
                        </Canvas>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            Spacing="6"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center">
                            <ComboBox
                                x:Name="EffectKindBox"
                                Width="104"
                                FontSize="12"
                                SelectionChanged="EffectKind_Changed" />
                            <Button
                                x:Name="AddButton"
                                Height="26"
                                FontSize="12"
                                Padding="10,0"
                                Click="Add_Click"
                                Content="Add Zoom" />
                            <ComboBox
                                x:Name="OptionBox"
                                Width="88"
                                FontSize="12"
                                SelectionChanged="Option_Changed" />
                            <Button
                                x:Name="DeleteButton"
                                Height="26"
                                FontSize="12"
                                Padding="10,0"
                                Click="Delete_Click"
                                Content="Delete Zoom" />
                        </StackPanel>
                    </Grid>

                    <!-- Only up while a caption is selected. macshot puts these on the
                         pill's own context menu; this port has no band menu, so they are a
                         row that appears with the thing they belong to. -->
                    <StackPanel
                        x:Name="CaptionPanel"
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="Collapsed">
                        <TextBox
                            x:Name="CaptionBox"
                            Width="280"
                            Height="28"
                            FontSize="12"
                            TextChanged="Caption_Changed" />
                        <!-- A CheckBox is shaped for a settings page by default: the label
                             sits above the box on a row this short unless the alignment,
                             the padding and the minimum height are all said here. -->
                        <CheckBox
                            x:Name="CaptionBoldBox"
                            Content="Bold"
                            FontSize="12"
                            MinWidth="0"
                            MinHeight="28"
                            Padding="8,0,0,0"
                            VerticalContentAlignment="Center"
                            Checked="CaptionStyle_Changed"
                            Unchecked="CaptionStyle_Changed" />
                        <CheckBox
                            x:Name="CaptionItalicBox"
                            Content="Italic"
                            FontSize="12"
                            MinWidth="0"
                            MinHeight="28"
                            Padding="8,0,0,0"
                            VerticalContentAlignment="Center"
                            Checked="CaptionStyle_Changed"
                            Unchecked="CaptionStyle_Changed" />
                        <!-- The two wells are built in code, because a ColorChoice takes
                             what it is called as a constructor argument. macshot's two
                             captions stand in front of them (VideoTextOptionsPanel.swift:264)
                             and are not translated there either: "Aa" and "BG" are the same
                             two characters in every language it ships. -->
                        <StackPanel
                            x:Name="CaptionColorGroup"
                            Orientation="Horizontal"
                            Spacing="6"
                            VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="CaptionBackBox"
                            Width="112"
                            FontSize="12"
                            SelectionChanged="CaptionStyle_Changed" />
                        <ComboBox
                            x:Name="CaptionAlignBox"
                            Width="96"
                            FontSize="12"
                            SelectionChanged="CaptionStyle_Changed" />
                    </StackPanel>
                </StackPanel>

                <Grid>
                    <TextBlock x:Name="ElapsedText" FontSize="11" Foreground="#8CFFFFFF" HorizontalAlignment="Left" />
                    <TextBlock x:Name="SelectionText" FontSize="11" Foreground="#8CFFFFFF" HorizontalAlignment="Center" />
                    <TextBlock x:Name="DurationText" FontSize="11" Foreground="#8CFFFFFF" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>

            <!-- Left: play, mute, the format toggle, and everything the file is.
                 Right: what to do with it. macshot's two groups, in its order.

                 In two columns, and the left one in a scroller. Both groups used to sit
                 in one cell, one aligned to each edge, which draws them on top of each
                 other the moment their widths add up to more than the row: a horizontal
                 StackPanel measures at infinity and arranges past its bounds rather than
                 shrinking. English fitted and Chinese did not, so "另存新檔…" came up
                 over the quality picker. The buttons are what must never be covered, so
                 they take their natural width and the readouts take what is left. -->
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The bar is hidden, not the scrolling: at the window's 900 minimum the
                     left group is wider than its column, so an Auto scroll bar drew a
                     thin rail along the bottom of the row from under the play button to
                     wherever its thumb ended. Under a row of controls that reads as a
                     rule someone meant to put there, and macshot's own row — which it is
                     copying — has nothing under it at all. The wheel still reaches the
                     readouts a narrow window pushes out of sight. -->
                <ScrollViewer
                    Grid.Column="0"
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Hidden"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button x:Name="PlayButton" Width="34" Height="28" Padding="0" Click="Play_Click" Content="▶" />
                    <Button x:Name="MuteButton" Width="34" Height="28" Padding="0" Click="Mute_Click" Content="🔊" />
                    <ComboBox x:Name="FormatBox" Width="86" FontSize="12" SelectionChanged="Export_Changed" />
                    <TextBlock x:Name="SourceInfoText" FontSize="11" Foreground="#66FFFFFF" VerticalAlignment="Center" />
                    <ComboBox x:Name="DimensionsBox" Width="170" FontSize="12" SelectionChanged="Export_Changed" />
                    <ComboBox x:Name="QualityBox" Width="96" FontSize="12" SelectionChanged="Export_Changed" />
                    <ComboBox x:Name="GifFrameRateBox" Width="90" FontSize="12" SelectionChanged="Export_Changed" />
                    <TextBlock x:Name="EstimateText" FontSize="11" Foreground="#59FFFFFF" VerticalAlignment="Center" />
                </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="SaveButton" MinWidth="100" Height="28" Click="Save_Click" Content="Save" />
                    <Button x:Name="SaveAsButton" Height="28" Click="SaveAs_Click" Content="Save As..." />
                    <Button x:Name="UploadButton" MinWidth="100" Height="28" Click="Upload_Click" Content="Upload" />
                    <Button x:Name="FolderButton" Width="34" Height="28" Padding="0" Click="Folder_Click" Content="📁" />
                    <Button x:Name="CopyButton" MinWidth="100" Height="28" Click="Copy_Click" Content="Copy Path" />
                </StackPanel>
            </Grid>

            <TextBlock x:Name="StatusText" FontSize="11" Foreground="#A6FFFFFF" />
        </StackPanel>
    </Grid>
</Window>
