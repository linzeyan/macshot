<Window
    x:Class="Macshot.Windows.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Capture">
    <Grid x:Name="OverlayRoot" Background="#FF000000" KeyDown="OverlayRoot_KeyDown">
        <Image x:Name="PreviewImage" Stretch="Fill" />
        <Canvas
            x:Name="SelectionCanvas"
            Background="Transparent"
            PointerPressed="SelectionCanvas_PointerPressed"
            PointerMoved="SelectionCanvas_PointerMoved"
            PointerReleased="SelectionCanvas_PointerReleased">
            <Rectangle
                x:Name="SelectionRectangle"
                Visibility="Collapsed"
                Stroke="#4CC2FF"
                StrokeThickness="2"
                Fill="#334CC2FF" />
        </Canvas>
        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,20,0,0"
            Padding="14,8"
            Background="#CC202020"
            CornerRadius="6">
            <TextBlock Text="Drag to capture • Esc to cancel" Foreground="White" />
        </Border>
    </Grid>
</Window>
