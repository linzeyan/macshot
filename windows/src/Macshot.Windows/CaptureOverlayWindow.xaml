<Window
    x:Class="Macshot.Windows.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Capture">
    <Grid x:Name="OverlayRoot" Background="#FF000000" KeyDown="OverlayRoot_KeyDown">
        <Image x:Name="PreviewImage" Stretch="Fill" />
        <Canvas
            x:Name="SelectionCanvas"
            Background="Transparent"
            PointerPressed="SelectionCanvas_PointerPressed"
            PointerMoved="SelectionCanvas_PointerMoved"
            PointerReleased="SelectionCanvas_PointerReleased">
            <!-- Declared before the marquee so a selection being dragged out draws
                 over the window highlight it is replacing, not under it. -->
            <Rectangle
                x:Name="SnapHighlight"
                Visibility="Collapsed"
                Stroke="#4CC2FF"
                StrokeThickness="2"
                RadiusX="4"
                RadiusY="4"
                Fill="#144CC2FF" />

            <Rectangle
                x:Name="SelectionRectangle"
                Visibility="Collapsed"
                Stroke="#4CC2FF"
                StrokeThickness="2"
                Fill="#334CC2FF" />
        </Canvas>

        <!-- Above SelectionCanvas so marks are not tinted by the selection fill, and
             never hit testable so pointer input keeps reaching the canvas below. -->
        <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" />

        <!-- Holds the elements glyph sprites are rasterized from, parked off-screen.
             RenderTargetBitmap only captures elements that are in the tree and have
             been arranged, so they cannot simply be built on the side. -->
        <Canvas x:Name="SpriteHost" IsHitTestVisible="False" />

        <!-- The text tool's entry box lives here. Unlike the layers above it this one
             is hit testable, but a Canvas with no background only hit tests its
             children, so a click anywhere else still reaches the selection canvas. -->
        <Canvas x:Name="TextEntryLayer" />

        <Border
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,20,0,0"
            Padding="14,8"
            Background="#CC202020"
            CornerRadius="6">
            <TextBlock
                x:Name="HintText"
                Text="Drag to capture • Click a window to take it • Esc to cancel"
                Foreground="White" />
        </Border>

        <Border
            x:Name="AnnotationToolbar"
            Visibility="Collapsed"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,32"
            Padding="8"
            Background="#EE202020"
            CornerRadius="8">
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <!-- Populated in code from AnnotationRasterizer.SupportedTools so the
                         toolbar cannot offer a tool the renderer would refuse to draw. -->
                    <StackPanel x:Name="ToolButtons" Orientation="Horizontal" Spacing="4" />
                    <Button Content="Undo" Click="Undo_Click" />
                    <Button Content="Redo" Click="Redo_Click" />
                    <Button Content="Read text" Click="ReadText_Click" />
                    <Button Content="Redact" Click="RedactPii_Click" />
                    <Button Content="Done" Click="Confirm_Click" Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Button Padding="6" ToolTipService.ToolTip="Colour">
                        <Border
                            x:Name="ColorSwatch"
                            Width="20"
                            Height="20"
                            CornerRadius="3"
                            BorderBrush="#66FFFFFF"
                            BorderThickness="1" />
                        <Button.Flyout>
                            <Flyout>
                                <!-- The style controls' change handlers are attached in
                                     code once the toolbar exists. See WireStyleControls. -->
                                <ColorPicker x:Name="StyleColorPicker" IsAlphaEnabled="True" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Armed, not a tool: sampling happens in the middle of drawing,
                         so it borrows one click and hands the current tool back. -->
                    <ToggleButton
                        x:Name="PickColorButton"
                        Content="Pick"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Take a colour from the screen"
                        Click="PickColor_Click" />

                    <TextBlock Text="Width" Foreground="White" VerticalAlignment="Center" />
                    <Slider
                        x:Name="StrokeWidthSlider"
                        Width="120"
                        Minimum="1"
                        Maximum="32"
                        StepFrequency="1"
                        VerticalAlignment="Center" />

                    <ComboBox x:Name="LineStyleBox" VerticalAlignment="Center" />

                    <!-- Which emoji the stamp tool places. Populated in code from
                         StampGlyph.Choices so the picker and the renderer cannot
                         offer different sets. -->
                    <Button x:Name="StampButton" VerticalAlignment="Center" ToolTipService.ToolTip="Stamp">
                        <Button.Flyout>
                            <Flyout>
                                <GridView x:Name="StampChoices" MaxWidth="240" SelectionMode="Single" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
