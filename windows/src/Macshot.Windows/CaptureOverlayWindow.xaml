<Window
    x:Class="Macshot.Windows.CaptureOverlayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Macshot.Windows"
    Title="Macshot Capture">
    <Grid x:Name="OverlayRoot" Background="#FF000000" KeyDown="OverlayRoot_KeyDown">
        <!-- Everything that is the capture, under one transform: the screenshot, the
             marks on it, the marquee and its grips. Zooming and panning move all of it
             together, and taking pointer positions relative to anything inside here gives
             them back in the capture's own coordinates however far in it is zoomed.

             The hint, the size box, the toolbar and the colour ring stay outside. They
             describe the capture rather than belong to it, and a toolbar that grew to
             three times its size at 3x would be unusable at exactly the magnification
             that needs it most. -->
        <Grid x:Name="ZoomHost">
            <Image x:Name="PreviewImage" Stretch="Fill" />

            <!-- Everything that is not being captured, darkened. Four rectangles around
                 the region rather than one with a hole in it: a hole is a path to rebuild
                 on every pointer move, and four rectangles are four numbers to change.
                 Above the screenshot and below the marquee, so the edge of the region
                 stays the brightest line on the screen. -->
            <Canvas x:Name="DimLayer" IsHitTestVisible="False">
                <Rectangle x:Name="DimTop" Fill="#73000000" />
                <Rectangle x:Name="DimBottom" Fill="#73000000" />
                <Rectangle x:Name="DimLeft" Fill="#73000000" />
                <Rectangle x:Name="DimRight" Fill="#73000000" />
            </Canvas>

            <!-- Input only. Everything it used to hold is drawn above the preview now;
                 what is left is a transparent surface the whole capture's worth of
                 pointer events arrive on. -->
            <local:PointerCanvas
                x:Name="SelectionCanvas"
                Background="Transparent"
                PointerPressed="SelectionCanvas_PointerPressed"
                PointerMoved="SelectionCanvas_PointerMoved"
                PointerReleased="SelectionCanvas_PointerReleased"
                PointerWheelChanged="SelectionCanvas_PointerWheelChanged" />

            <!-- Above SelectionCanvas so marks are not tinted by the selection fill. The
                 same surface the editor window draws on; its own layers are not hit
                 testable, so pointer input keeps reaching the selection canvas below. -->
            <local:AnnotationCanvasView x:Name="AnnotationCanvas" />

            <!-- The marquee, above the preview. The preview is placed exactly on the
                 region, so declared any lower it covered the inner half of the outline
                 and — wherever the layout units rounded outwards — all of it, which left
                 the region with no visible edge for as long as it was being annotated.
                 macOS draws this border after the annotations for the same reason. -->
            <Canvas x:Name="SelectionMarquee" IsHitTestVisible="False">
                <!-- Declared before the marquee so a selection being dragged out draws
                     over the window highlight it is replacing, not under it. -->
                <Rectangle
                    x:Name="SnapHighlight"
                    Visibility="Collapsed"
                    Stroke="#D9007AFF"
                    StrokeThickness="2"
                    RadiusX="4"
                    RadiusY="4"
                    Fill="#14007AFF" />

                <!-- Outlined but not filled: what is inside is the capture, and it is
                     shown as it will be delivered. Everything outside is darkened
                     instead, which is what says where the edges are. The stroke is
                     assigned in code, from the toolbar's accent, so the region and the
                     toolbar that hangs off it are never two different colours. -->
                <Rectangle
                    x:Name="SelectionRectangle"
                    Visibility="Collapsed"
                    StrokeThickness="2" />
            </Canvas>

            <!-- The selection's grips, above the marquee because they straddle its edge:
                 declared any lower, the preview would cover their inner half and leave
                 eight half-squares. Not hit testable either — which grip a point grabs is
                 arithmetic SelectionHandles answers, so these only have to be visible. -->
            <Canvas x:Name="SelectionGrips" IsHitTestVisible="False" />

            <!-- The colour sampler's magnified circle. Above the grips because it is
                 shown while the pointer is over the image and must not be cut in half by
                 anything the overlay draws. -->
            <Canvas x:Name="LoupeLayer" IsHitTestVisible="False" />
        </Grid>

        <!-- The instruction, and anything else the overlay has to say. Placed in code:
             macOS puts it in the middle of the screen while nothing is chosen and just
             above the region once something is, and takes it away entirely for the rest of
             the annotation phase — a standing instruction over a chosen region is a strip
             of the capture the user cannot see past for as long as they are working on it.
             Its own layer so it is above the capture and never in it. -->
        <Canvas x:Name="HintLayer" IsHitTestVisible="False">
            <Border
                x:Name="HintPill"
                Padding="14"
                Background="#A6000000"
                CornerRadius="8">
                <TextBlock
                    x:Name="HintText"
                    Text="Drag to capture • Hold Space to move it • Click a window to take it • Esc to cancel"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="White" />
            </Border>
        </Canvas>

        <!-- The width × height box, which is put here in code so it can stay internal to
             the assembly like the rest of the toolbar's parts. -->
        <Canvas x:Name="SizeBoxLayer" />

        <!-- The tools, the actions and the tool options, each placed around the chosen
             region rather than pinned to the display. Fills the window so it has the
             room to put them anywhere; a Canvas with no background is only hit testable
             where its children are, so the gaps still reach the surfaces below. -->
        <local:AnnotationToolbarView x:Name="AnnotationToolbar" Visibility="Collapsed" />
    </Grid>
</Window>
