<Application
    x:Class="Macshot.Windows.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <!-- Merged rather than assigned straight to Application.Resources. Both shapes
             are accepted, but only this one is what every WinUI app is built from, and
             the symptom of the theme dictionary not being in place is not a missing
             style — it is "XAML parsing failed." from the first window that asks for
             one, naming neither the window nor the key. -->
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
