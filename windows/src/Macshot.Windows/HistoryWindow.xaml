<Window
    x:Class="Macshot.Windows.HistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="macshot history">

    <!-- macshot's panel: white 0.10 at 0.92 over the screen. Opaque here, because a
         WinUI window has no per-pixel alpha and the colour behind it is unknowable. -->
    <Grid
        x:Name="PanelRoot"
        Background="#1A1A1A"
        RequestedTheme="Dark"
        IsTabStop="True"
        RowDefinitions="50,*"
        KeyDown="PanelRoot_KeyDown">

        <!-- Filter tabs, built in code so the active one can be repainted without a
             style selector for three buttons. -->
        <StackPanel
            x:Name="Filters"
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="6"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <Button
            x:Name="Trash"
            Grid.Row="0"
            Width="22"
            Height="22"
            Padding="0"
            Margin="0,0,24,0"
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            Background="Transparent"
            BorderThickness="0"
            Click="Trash_Click">
            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="#73FFFFFF" />
        </Button>

        <ScrollViewer
            x:Name="Row"
            Grid.Row="1"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Hidden"
            VerticalScrollMode="Disabled"
            VerticalScrollBarVisibility="Disabled">
            <StackPanel
                x:Name="Cards"
                Orientation="Horizontal"
                Spacing="14"
                Margin="24,8,24,0"
                VerticalAlignment="Top" />
        </ScrollViewer>

        <!-- The row runs off both edges when there is more history than fits, and a card
             cut dead at the panel edge reads as the last one. -->
        <Rectangle
            Grid.Row="1"
            Width="30"
            HorizontalAlignment="Left"
            IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1A1A" Offset="0" />
                    <GradientStop Color="#001A1A1A" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Rectangle
            Grid.Row="1"
            Width="30"
            HorizontalAlignment="Right"
            IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#001A1A1A" Offset="0" />
                    <GradientStop Color="#1A1A1A" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- Shown in place of the row when there is nothing in it, because an empty
             panel says nothing about whether history is off or simply new. -->
        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Text="No captures yet. Every capture macshot saves appears here."
            FontSize="12"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Visibility="Collapsed"
            Foreground="#73FFFFFF" />
    </Grid>
</Window>
