<Window
    x:Class="Macshot.Windows.WebcamWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="macshot webcam">

    <!-- Black behind the picture, not transparent: the window is cut to shape with a
         region, so anything outside the cut is gone rather than showing through. -->
    <Grid x:Name="BubbleRoot" Background="#000000">
        <Image x:Name="Preview" Stretch="UniformToFill" />

        <!-- macshot's white-50% ring at 2. Drawn inside the content because the window
             has no border of its own once it is chromeless. -->
        <Ellipse
            x:Name="CircleRing"
            Stroke="#80FFFFFF"
            StrokeThickness="2"
            Margin="1" />

        <Rectangle
            x:Name="RectRing"
            Stroke="#80FFFFFF"
            StrokeThickness="2"
            Margin="1"
            Visibility="Collapsed" />

        <!-- Until the first frame arrives. A black square that turns into a face is
             indistinguishable from a camera that never started. -->
        <ProgressRing
            x:Name="Waiting"
            Width="24"
            Height="24"
            IsActive="True"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Window>
