<UserControl
    x:Class="Macshot.Windows.AnnotationCanvasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <!-- The preview: the selected pixels with every mark composited in by the Core
             rasterizer. Never hit testable, so pointer input keeps reaching whatever the
             host has underneath. -->
        <Canvas x:Name="AnnotationLayer" IsHitTestVisible="False" />

        <!-- Holds the elements glyph sprites are rasterized from, parked off-screen.
             RenderTargetBitmap only captures elements that are in the tree and have
             been arranged, so they cannot simply be built on the side. -->
        <Canvas x:Name="SpriteHost" IsHitTestVisible="False" />

        <!-- The chrome around the selected mark: its outline and its grab handles. A
             layer of its own above the preview, because it must never reach the pixels
             that get delivered — the rasterizer draws marks, not the furniture for
             editing them. -->
        <Canvas x:Name="SelectionLayer" IsHitTestVisible="False" />

        <!-- The only part of the chrome that is a control: the one button a group of
             selected marks is deleted with. A layer of its own because the one above is
             not hit testable at all, and a Canvas with no background hit tests only its
             children — so a press anywhere else still reaches the host below. -->
        <Canvas x:Name="SelectionControls" />

        <!-- The text tool's entry box lives here. Unlike the layers above it this one
             is hit testable, but a Canvas with no background only hit tests its
             children, so a click anywhere else still reaches the host below. -->
        <Canvas x:Name="TextEntryLayer" />
    </Grid>
</UserControl>
