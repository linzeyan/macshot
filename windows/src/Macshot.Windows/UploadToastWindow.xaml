<Window
    x:Class="Macshot.Windows.UploadToastWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Upload">
    <!-- macshot's toast: 380 wide, 14 of corner, the app icon at 14 from the left with a
         spinner over it while the upload runs. Dark whatever the system theme is, as
         every other panel this port draws is, so every foreground here is set rather
         than inherited. Clicking anywhere but the button dismisses it, which is what
         macshot's own background view does. -->
    <Grid
        x:Name="ToastRoot"
        Background="#F01F1F1F"
        BorderBrush="#1AFFFFFF"
        BorderThickness="0.5"
        PointerPressed="ToastRoot_PointerPressed">

        <Image
            x:Name="AppIcon"
            Width="28"
            Height="28"
            Margin="14,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Visibility="Collapsed" />

        <ProgressRing
            x:Name="Spinner"
            Width="20"
            Height="20"
            Margin="18,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Foreground="#FFFFFF"
            IsActive="True" />

        <!-- One column of text between the icon and the button. The button's column is
             kept at its width even while there is no button, so the status text does not
             reflow the moment the upload finishes. -->
        <Grid Margin="50,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="StatusText"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="#FFFFFF"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="LinkText"
                    FontSize="11"
                    Foreground="#A0A0A0"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Button
                x:Name="OpenButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="12,4"
                VerticalAlignment="Center"
                Content="Open"
                FontSize="12"
                Click="Open_Click"
                Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
