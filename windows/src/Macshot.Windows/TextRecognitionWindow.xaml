<Window
    x:Class="Macshot.Windows.TextRecognitionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recognized text">
    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="16"
        RowDefinitions="*,Auto"
        RowSpacing="12">
        <!-- Editable on purpose: OCR misreads characters, and fixing a wrong letter
             before copying is faster than retyping the line somewhere else. -->
        <TextBox
            x:Name="RecognizedTextBox"
            AcceptsReturn="True"
            TextWrapping="Wrap"
            IsSpellCheckEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Auto" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <TextBlock
                x:Name="StatusText"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <Button Content="Close" Click="Close_Click" />
            <Button Content="Copy" Click="Copy_Click" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Window>
