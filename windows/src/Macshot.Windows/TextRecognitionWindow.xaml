<Window
    x:Class="Macshot.Windows.TextRecognitionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Recognized text">
    <!-- macshot's shape: the capture down the left, a hairline, then the words. Without
         the preview there is nothing beside the text saying where it came from, which
         matters most exactly when OCR has misread something. -->
    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        ColumnDefinitions="240,1,*">
        <Border x:Name="PreviewPane" Background="#40000000">
            <Border CornerRadius="6" Margin="12">
                <Image x:Name="PreviewImage" Stretch="Uniform" />
            </Border>
        </Border>

        <Border
            x:Name="PreviewSeparator"
            Grid.Column="1"
            Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

        <Grid Grid.Column="2" RowDefinitions="52,*,52">
            <!-- Header: what to translate into, the button that does it, and how much
                 text was read. macshot's 52, with a 28 row inside it. -->
            <Grid Padding="12,0" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                <TextBlock
                    x:Name="TranslateLabel"
                    Text="Translate to:"
                    FontSize="12"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    VerticalAlignment="Center" />

                <ComboBox
                    x:Name="TargetLanguageBox"
                    Grid.Column="1"
                    Width="150"
                    Height="28"
                    VerticalAlignment="Center"
                    SelectionChanged="TargetLanguage_Changed" />

                <Button
                    x:Name="TranslateButton"
                    Grid.Column="2"
                    Width="100"
                    Height="28"
                    Padding="0"
                    Content="Translate"
                    VerticalAlignment="Center"
                    Click="Translate_Click" />

                <TextBlock
                    x:Name="CountText"
                    Grid.Column="3"
                    FontSize="11"
                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                    TextAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>

            <!-- Editable on purpose: OCR misreads characters, and fixing a wrong letter
                 before copying is faster than retyping the line somewhere else. -->
            <TextBox
                x:Name="RecognizedTextBox"
                Grid.Row="1"
                Margin="12,0"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                IsSpellCheckEnabled="False"
                ScrollViewer.VerticalScrollBarVisibility="Auto" />

            <StackPanel
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Padding="12,0"
                Spacing="8">
                <TextBlock
                    x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <Button Content="Close" Click="Close_Click" />
                <Button Content="Copy" Click="Copy_Click" Style="{StaticResource AccentButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
