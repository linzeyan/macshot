<Window
    x:Class="Macshot.Windows.RecordedRegionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Recording Region">
    <!-- The whole window is the border. Its middle is cut away by a window region, so
         what is left on screen is a frame round the recorded rectangle. The colour is
         set in code from the toolbar accent the user chose. -->
    <Grid x:Name="Frame" />
</Window>
