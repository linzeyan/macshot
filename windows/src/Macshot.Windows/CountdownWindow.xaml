<Window
    x:Class="Macshot.Windows.CountdownWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Countdown">
    <!-- macshot's dial, in its numbers: a 140 window, a disc inset 10, a 3-wide ring
         inset another 3 inside that, and the count at 52 across the middle. It is read
         at a glance from across the desk while both hands are busy arranging whatever is
         about to be captured, which is why it is a dial and not a sentence.

         The disc is opaque where macshot's is black at 70%. A WinUI window has no
         per-pixel transparency, so the desktop cannot show through it; the corners of
         the square window are cut away with an elliptical region instead, and this tone
         is what macshot's translucent disc averages to. -->
    <Grid x:Name="DialRoot" Background="#262626">
        <Ellipse Margin="13" Stroke="#99FFFFFF" StrokeThickness="3" />

        <!-- Windows 11's UI font comes in optical sizes and the theme's default is the
             one cut for body text: at 52 its spacing is set for a size it will never be
             used at, and a single numeral shows it. Display is the cut for this, and the
             fallback is what Windows 10 was going to use anyway. -->
        <TextBlock
            x:Name="SecondsText"
            Text="5"
            FontSize="52"
            FontFamily="Segoe UI Variable Display, Segoe UI"
            FontWeight="Bold"
            Foreground="#FFFFFF"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Grid>
</Window>
