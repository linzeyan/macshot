<Window
    x:Class="Macshot.Windows.ThumbnailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Capture">

    <Grid
        x:Name="ThumbnailRoot"
        Background="#1F1F1F"
        PointerEntered="ThumbnailRoot_PointerEntered"
        PointerExited="ThumbnailRoot_PointerExited"
        PointerPressed="ThumbnailRoot_PointerPressed"
        PointerMoved="ThumbnailRoot_PointerMoved"
        PointerReleased="ThumbnailRoot_PointerReleased"
        PointerCaptureLost="ThumbnailRoot_PointerReleased">

        <!-- On the root element rather than on the Window. A WinUI Window is not a
             FrameworkElement and has no Resources of its own — that is WPF, where this
             markup would have compiled. Everything that uses these lives under this
             Grid, so the lookup is unchanged. -->
        <Grid.Resources>
            <!-- macshot's hover chrome: a 28 disc at white 18% behind a white-50% hairline. -->
            <Style x:Key="CornerDisc" TargetType="Border">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Background" Value="#2EFFFFFF" />
                <Setter Property="BorderBrush" Value="#80FFFFFF" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Margin" Value="10" />
            </Style>

            <!-- The two actions worth a word rather than a picture, at macshot's 110 x 32 on
                 white 85% — which is why their labels are dark. -->
            <Style x:Key="CentreAction" TargetType="Border">
                <Setter Property="Width" Value="110" />
                <Setter Property="Height" Value="32" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Background" Value="#D9FFFFFF" />
            </Style>
        </Grid.Resources>

        <Grid.ContextFlyout>
            <!-- Everything the panel has no room to show, which is where macshot keeps
                 the same list. -->
            <MenuFlyout>
                <MenuFlyoutItem Text="Copy" Click="Copy_Click" />
                <MenuFlyoutItem Text="Save" Click="Save_Click" />
                <MenuFlyoutItem Text="Save As..." Click="SaveAs_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Pin" Click="Pin_Click" />
                <MenuFlyoutItem Text="Open in Editor Window" Click="Edit_Click" />
                <MenuFlyoutItem Text="OCR &amp; QR" Click="ReadText_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Delete" Click="Delete_Click" />
                <MenuFlyoutItem Text="Close" Click="Close_Click" />
                <MenuFlyoutItem Text="Close All" Click="CloseAll_Click" />
            </MenuFlyout>
        </Grid.ContextFlyout>

        <!-- Aspect fill, cropped, as macshot's is: a letterboxed thumbnail of a wide
             capture is mostly background, and the panel is there to be recognised at a
             glance rather than read. -->
        <Image x:Name="ThumbnailImage" Stretch="UniformToFill" />

        <Grid x:Name="HoverLayer" Background="#73000000" Visibility="Collapsed">
            <Border
                x:Name="CloseDisc"
                Style="{StaticResource CornerDisc}"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                PointerPressed="Close_PointerPressed" />

            <Border
                x:Name="PinDisc"
                Style="{StaticResource CornerDisc}"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                PointerPressed="Pin_PointerPressed" />

            <Border
                x:Name="EditDisc"
                Style="{StaticResource CornerDisc}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                PointerPressed="Edit_PointerPressed" />

            <!-- The fourth corner is macshot's upload button, and it is now that. The
                 offline build hides it rather than filling it with something else:
                 someone who knows where upload is on macOS must not find a different
                 action in its place. -->
            <Border
                x:Name="UploadDisc"
                Style="{StaticResource CornerDisc}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                PointerPressed="Upload_PointerPressed" />

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <Border Style="{StaticResource CentreAction}" PointerPressed="Copy_PointerPressed">
                    <TextBlock
                        Text="Copy"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#1F1F1F"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <Border Style="{StaticResource CentreAction}" PointerPressed="Save_PointerPressed">
                    <TextBlock
                        Text="Save"
                        FontSize="13"
                        FontWeight="Medium"
                        Foreground="#1F1F1F"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
