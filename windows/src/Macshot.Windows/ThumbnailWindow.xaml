<Window
    x:Class="Macshot.Windows.ThumbnailWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Capture">
    <Grid
        x:Name="ThumbnailRoot"
        Background="#EE202020"
        Padding="8"
        RowDefinitions="*,Auto"
        RowSpacing="8"
        PointerEntered="ThumbnailRoot_PointerEntered"
        PointerExited="ThumbnailRoot_PointerExited">
        <Border CornerRadius="4" Background="#101010">
            <Image x:Name="ThumbnailImage" Stretch="Uniform" />
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4">
            <Button Content="Copy" Click="Copy_Click" />
            <Button Content="Save" Click="Save_Click" />
            <Button Content="Pin" Click="Pin_Click" />
            <Button Content="Edit" Click="Edit_Click" />
            <Button Content="Close" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
