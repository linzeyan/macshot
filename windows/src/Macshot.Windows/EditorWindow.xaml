<Window
    x:Class="Macshot.Windows.EditorWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Macshot.Windows"
    Title="macshot">

    <Grid x:Name="EditorRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}" KeyDown="EditorRoot_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The operations that change the pixels rather than draw on them, in macshot's
             own top bar: the full width of the window, 32 tall, opaque, with a hairline
             along its bottom edge. It belongs to the window rather than floating over the
             image, so the image starts below it rather than behind it — which is also what
             stops a capture's top-left corner from being under a button. Dark whatever the
             system theme is, to match the toolbar it shares a window with. -->
        <Border
            x:Name="ImageOperationsBar"
            Grid.Row="0"
            Height="32"
            Background="#1F1F1F"
            BorderBrush="#404040"
            BorderThickness="0,0,0,0.5"
            RequestedTheme="Dark">
            <Grid>
                <StackPanel
                    x:Name="ImageOperations"
                    Orientation="Horizontal"
                    VerticalAlignment="Center" />

                <!-- At the trailing edge, 12 in, where macshot keeps it. -->
                <StackPanel
                    x:Name="ZoomHost"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,12,0" />
            </Grid>
        </Border>

        <!-- Zoom is the ScrollViewer's, which is the whole reason the editor exists as a
             separate window: a scroll capture is taller than any screen, and a region
             capture is often smaller than the window it is being marked up in. Content
             alignment centres an image that does not fill the viewport, so a small
             capture sits in the middle rather than in the corner. -->
        <ScrollViewer
            Grid.Row="1"
            x:Name="Scroller"
            ZoomMode="Enabled"
            MinZoomFactor="0.1"
            MaxZoomFactor="8"
            HorizontalScrollMode="Auto"
            HorizontalScrollBarVisibility="Auto"
            VerticalScrollBarVisibility="Auto"
            HorizontalContentAlignment="Center"
            VerticalContentAlignment="Center"
            SizeChanged="Scroller_SizeChanged"
            ViewChanged="Scroller_ViewChanged">

            <!-- Sized to the image in pixels, so one layout unit is one pixel and the
                 placement between marks and pixels is the identity. -->
            <Grid x:Name="ImageHost">
                <!-- Below the drawing surface, the way the overlay's selection canvas is:
                     the surface's own layers are not hit testable, so pointer input falls
                     through to here, and the text tool's box above it still gets clicks. -->
                <local:PointerCanvas
                    x:Name="InputCanvas"
                    Background="Transparent"
                    PointerPressed="InputCanvas_PointerPressed"
                    PointerMoved="InputCanvas_PointerMoved"
                    PointerReleased="InputCanvas_PointerReleased" />


                <local:AnnotationCanvasView x:Name="AnnotationCanvas" />

                <!-- The crop rectangle being dragged out. Above the image, never hit
                     testable: the drag is tracked on the input canvas below. A Canvas
                     rather than a bare Rectangle because Canvas.Left and Canvas.Top are
                     what position it, and they mean nothing to a Grid. -->
                <Canvas IsHitTestVisible="False">
                    <Rectangle
                        x:Name="CropRectangle"
                        Visibility="Collapsed"
                        Stroke="#4CC2FF"
                        StrokeThickness="2"
                        Fill="#334CC2FF" />
                </Canvas>
            </Grid>
        </ScrollViewer>

        <Border
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,12,0,0"
            Padding="14,8"
            Background="#CC202020"
            CornerRadius="6">
            <TextBlock x:Name="HintText" Foreground="White" />
        </Border>

        <local:AnnotationToolbarView Grid.Row="1" x:Name="AnnotationToolbar" />
    </Grid>
</Window>
