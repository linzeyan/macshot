<Window
    x:Class="Macshot.Windows.AudioMergeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Audio Tracks">
    <!-- macshot's panel: the question, a row per track, and the two answers along the
         bottom with Merge as the one Return presses. The rows themselves are built in
         code, one per track in the order AudioMerge lists them. -->
    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Padding="20,16,20,16"
        RowDefinitions="Auto,*,Auto"
        RowSpacing="12"
        KeyDown="Panel_KeyDown">
        <TextBlock
            Text="Adjust volume for each audio track:"
            FontSize="12"
            FontWeight="SemiBold"
            TextWrapping="Wrap" />

        <StackPanel
            x:Name="TrackRows"
            Grid.Row="1"
            Spacing="4"
            VerticalAlignment="Top" />

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="8">
            <!-- macshot's 115-wide buttons, and its order: the answer that changes nothing
                 sits to the left of the one that does. -->
            <Button
                MinWidth="115"
                Content="Keep Separate"
                Click="KeepSeparate_Click" />
            <Button
                x:Name="MergeButton"
                MinWidth="115"
                Content="Merge Audio"
                Style="{StaticResource AccentButtonStyle}"
                Click="Merge_Click" />
        </StackPanel>
    </Grid>
</Window>
