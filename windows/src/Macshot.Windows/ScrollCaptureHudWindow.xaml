<Window
    x:Class="Macshot.Windows.ScrollCaptureHudWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Scroll Capture">
    <Grid Background="#EE202020" Padding="12" ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel VerticalAlignment="Center" Spacing="2">
            <!-- Foreground is set rather than inherited: the panel is dark whatever
                 the system theme is, so a light-theme default would be invisible. -->
            <TextBlock x:Name="ProgressText" Foreground="#FFFFFF" Text="Scrolling..." />
            <TextBlock
                x:Name="StopHintText"
                Foreground="#B0B0B0"
                FontSize="12"
                Text="Esc or Stop keeps what has been captured so far" />
        </StackPanel>

        <Button
            Grid.Column="1"
            Content="Stop"
            VerticalAlignment="Center"
            Click="Stop_Click" />
    </Grid>
</Window>
