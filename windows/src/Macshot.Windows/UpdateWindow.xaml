<Window
    x:Class="Macshot.Windows.UpdateWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Macshot Update">
    <!-- The upload toast's shape, because it is the same kind of thing: 380 wide at the
         top centre of the main display, dark whatever the system theme is, every
         foreground set rather than inherited. Unlike that one it does not dismiss on a
         click — it is reporting work that ends by restarting the app, and a panel that
         went away on a stray click would leave that restart looking like a crash. -->
    <Grid
        x:Name="PanelRoot"
        Background="#F01F1F1F"
        BorderBrush="#1AFFFFFF"
        BorderThickness="0.5">

        <ProgressRing
            x:Name="Spinner"
            Width="20"
            Height="20"
            Margin="18,0,0,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Foreground="#FFFFFF"
            IsActive="True" />

        <StackPanel Margin="50,0,14,0" VerticalAlignment="Center" Spacing="6">
            <TextBlock
                x:Name="StatusText"
                FontSize="13"
                FontWeight="Medium"
                Foreground="#FFFFFF"
                TextWrapping="Wrap" />

            <!-- Determinate wherever GitHub said how large the file is, which it does for
                 every asset it serves. A bar that only spins would say nothing about a
                 download this size. -->
            <ProgressBar
                x:Name="Bar"
                Height="3"
                Minimum="0"
                Maximum="1"
                Foreground="#FFFFFF"
                Background="#33FFFFFF" />
        </StackPanel>
    </Grid>
</Window>
