<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="Macshot.Windows.app" />

  <!--
    Per-monitor-DPI-v2 awareness is a correctness requirement, not a polish item.
    Without it Windows virtualizes coordinates for a process it considers
    DPI-unaware: GetSystemMetrics and EnumDisplayMonitors then report scaled
    values, so a capture taken on a 150% display comes back blurry and the wrong
    size. dpiAware is the Windows 8.1 fallback for hosts that do not understand
    dpiAwareness.
  -->
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/PM</dpiAware>
    </windowsSettings>
  </application>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and later. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>
</assembly>
